# Copy to .env (or set in your hosting dashboard). Everything is OPTIONAL —
# without keys the app runs fully, using the offline knowledge engine and alert simulation.

PORT=3000

# Claude (Anthropic) — enables free-form agronomist chat, personalised prescription tips
# and the "Cloud AI second opinion" vision check.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5

# Twilio — real SMS / WhatsApp outbreak alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=              # e.g. +15551234567 (SMS-capable Twilio number)
TWILIO_WHATSAPP_FROM=     # e.g. +14155238886 (Twilio WhatsApp sandbox/sender)

# Telegram bot — alerts to a chat ID
TELEGRAM_BOT_TOKEN=

# Secret used to encrypt subscriber phone numbers (AES-256-GCM). Set in production!
DATA_KEY=
# DATA_DIR=./data
